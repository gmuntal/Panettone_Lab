# Copy to .env and replace secrets before deploying.
GHCR_IMAGE=ghcr.io/OWNER/panettone-lab
IMAGE_TAG=latest
PANETTONE_PORT=8088
APP_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-a-long-unique-password
READONLY_API_TOKEN=
SESSION_COOKIE_SECURE=false

# Tapo C210 RTSP. Put credentials here if RTSP authentication is enabled.
CAMERA_RTSP_URL=rtsp://10.85.3.237:554/stream1
CAMERA_USERNAME=
CAMERA_PASSWORD=

# Shelly Plus UNI RPC
SHELLY_URL=http://10.85.3.202/rpc/Shelly.GetStatus
SHELLY_USERNAME=
SHELLY_PASSWORD=
TEMPERATURE_KEY=temperature:100.tC
HUMIDITY_KEY=humidity:100.rh
SENSOR_INTERVAL_SECONDS=30
PHOTO_INTERVAL_SECONDS=120
